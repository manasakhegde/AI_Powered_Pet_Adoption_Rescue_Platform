pipeline {
    agent any

    environment {
        REGISTRY = 'docker.io'
        REGISTRY_CREDENTIALS = 'docker-hub-credentials'
        BACKEND_IMAGE = 'your-dockerhub-username/pet-adoption-backend'
        FRONTEND_IMAGE = 'your-dockerhub-username/pet-adoption-frontend'
        IMAGE_TAG = "${BUILD_NUMBER}"
        DEPLOYMENT_BRANCH = 'main'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo 'Code checked out successfully'
            }
        }

        stage('Build Backend') {
            steps {
                dir('backend') {
                    script {
                        echo 'Building Spring Boot backend...'
                        sh '''
                            mvn clean package -DskipTests
                        '''
                    }
                }
            }
        }

        stage('Build Frontend') {
            steps {
                dir('frontend') {
                    script {
                        echo 'Installing frontend dependencies...'
                        sh '''
                            npm ci
                            npm run build
                        '''
                    }
                }
            }
        }

        stage('Unit Tests - Backend') {
            steps {
                dir('backend') {
                    script {
                        echo 'Running backend unit tests...'
                        sh '''
                            mvn test
                        '''
                    }
                }
            }
        }

        stage('Unit Tests - Frontend') {
            steps {
                dir('frontend') {
                    script {
                        echo 'Running frontend tests...'
                        sh '''
                            npm test -- --watchAll=false --coverage
                        '''
                    }
                }
            }
        }

        stage('Code Quality Analysis') {
            steps {
                script {
                    echo 'Running code quality checks...'
                    dir('backend') {
                        sh '''
                            mvn sonar:sonar -Dsonar.projectKey=pet-adoption-platform \
                            -Dsonar.host.url=http://sonarqube:9000 \
                            -Dsonar.login=${SONAR_TOKEN} || true
                        '''
                    }
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                script {
                    echo 'Building Docker images...'
                    sh '''
                        docker build -t ${BACKEND_IMAGE}:${IMAGE_TAG} ./backend
                        docker build -t ${FRONTEND_IMAGE}:${IMAGE_TAG} ./frontend
                        docker tag ${BACKEND_IMAGE}:${IMAGE_TAG} ${BACKEND_IMAGE}:latest
                        docker tag ${FRONTEND_IMAGE}:${IMAGE_TAG} ${FRONTEND_IMAGE}:latest
                    '''
                }
            }
        }

        stage('Push to Registry') {
            when {
                branch "${DEPLOYMENT_BRANCH}"
            }
            steps {
                script {
                    echo 'Pushing images to Docker registry...'
                    withCredentials([usernamePassword(credentialsId: "${REGISTRY_CREDENTIALS}", usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        sh '''
                            echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                            docker push ${BACKEND_IMAGE}:${IMAGE_TAG}
                            docker push ${BACKEND_IMAGE}:latest
                            docker push ${FRONTEND_IMAGE}:${IMAGE_TAG}
                            docker push ${FRONTEND_IMAGE}:latest
                            docker logout
                        '''
                    }
                }
            }
        }

        stage('Deploy to Staging') {
            when {
                branch "${DEPLOYMENT_BRANCH}"
            }
            steps {
                script {
                    echo 'Deploying to staging environment...'
                    sh '''
                        # Update docker-compose with new image tags
                        sed -i "s|backend:.*|backend:${IMAGE_TAG}|g" docker-compose.yml
                        sed -i "s|frontend:.*|frontend:${IMAGE_TAG}|g" docker-compose.yml
                        
                        # Deploy using docker-compose
                        docker-compose -f docker-compose.yml up -d
                        
                        # Wait for services to be healthy
                        sleep 30
                    '''
                }
            }
        }

        stage('Smoke Tests') {
            steps {
                script {
                    echo 'Running smoke tests...'
                    sh '''
                        # Test backend health
                        curl -f http://localhost:8080/api/pets || exit 1
                        
                        # Test frontend availability
                        curl -f http://localhost:3000 || exit 1
                    '''
                }
            }
        }

        stage('Security Scan') {
            steps {
                script {
                    echo 'Running security scans...'
                    dir('backend') {
                        sh '''
                            # Run OWASP Dependency Check
                            mvn org.owasp:dependency-check-maven:check || true
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            // Archive test results
            junit '**/target/surefire-reports/*.xml'
            junit '**/coverage/*.xml'
            
            // Archive logs
            archiveArtifacts artifacts: '**/target/logs/**/*.log', allowEmptyArchive: true
            
            // Clean up
            cleanWs()
        }

        success {
            echo 'Pipeline completed successfully!'
            // Send success notification (configure based on your needs)
        }

        failure {
            echo 'Pipeline failed!'
            // Send failure notification (configure based on your needs)
        }
    }
}
